{
  "name": "dongxuelian-dashboard-jest-and-cypress",
  "private": true,
  "version": "1.0.0",
  "description": "主控制台 Jest 单元/组件/集成测试与 Cypress 浏览器测试",
  "scripts": {
    "test": "npm run test:unit && npm run test:component && npm run test:integration",
    "test:unit": "jest --runInBand tests/unit",
    "test:component": "jest --runInBand tests/component",
    "test:integration": "jest --runInBand tests/integration",
    "test:e2e": "node scripts/run-e2e.cjs",
    "dev": "vite --host 127.0.0.1 --port 41731 --strictPort",
    "cypress:run": "node scripts/run-cypress.cjs"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "@babel/preset-typescript": "^7.28.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/compiler-sfc": "^3.5.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/vue3-jest": "^29.2.6",
    "babel-jest": "^29.7.0",
    "cypress": "^15.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vue": "^3.5.0"
  }
}
