{
  "name": "dongxuelian-dashboard",
  "version": "1.0.1",
  "description": "LianLian Bot Console - Desktop Edition",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "pack": "electron-builder --win --dir"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.dongxuelian.dashboard",
    "productName": "LianLianBot",
    "electronVersion": "35.0.0",
    "directories": {
      "output": "../../dist-desktop"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../koishi-plugin-dashboard",
        "to": "dashboard",
        "filter": ["standalone.js", "frontend/dist/**"]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "LianLianBot"
    }
  }
}
